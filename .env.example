# Copia este archivo a `.env` (desarrollo con Bun) y a `.dev.vars` (wrangler dev).
# NUNCA subas `.env` ni `.dev.vars` al repositorio.
# Guía completa: Documentacion/entorno-supabase-cloudflare.md

# --- Servidor ---
PORT=3000
# Orígenes permitidos por CORS, separados por coma. Vacío o comentado = cualquier origen.
# Ej: http://localhost:5173,https://front.pages.dev
# CORS_ORIGIN=

# --- Supabase (Dashboard > Project Settings > API Keys / General) ---
# Project ref: la parte de https://<ref>.supabase.co
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://<project-ref>.supabase.co
# Clave pública (sb_publishable_...). Segura para el cliente.
SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...). SOLO backend. Omite RLS: jamás la expongas al frontend.
SUPABASE_SECRET_KEY=

# --- Base de datos (Dashboard > botón "Connect" > Connection string) ---
# El Worker NO usa estas: en Workers la conexión va por Hyperdrive (wrangler.jsonc).
# DATABASE_URL (transaction pooler, 6543) la usan los scripts de Bun (usuario:crear).
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler (5432): origen del Hyperdrive y conexión para migraciones.
DATABASE_URL_MIGRATIONS=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# `wrangler dev` emula el binding HYPERDRIVE conectando directo a esta cadena.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Storage de fotos: Cloudflare R2 (Dashboard > R2 Object Storage) ---
# Nombre del bucket. En el Worker se accede por binding (wrangler.jsonc > r2_buckets), sin llaves.
R2_STORAGE_BUCKET=
# URL pública base para mostrar las fotos: dominio personalizado o URL "r2.dev" del bucket
# (bucket > Settings > Public access). Sin barra final. Ej: https://pub-xxxx.r2.dev
R2_PUBLIC_URL=
# Opcionales: solo si subes a R2 por la API S3 desde fuera del Worker (p. ej. `bun run dev`).
# Se obtienen en R2 > Manage API Tokens (Object Read & Write sobre el bucket).
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# --- Lógica de la app ---
# Radio (en metros) dentro del cual varios reportes se agrupan y suben la urgencia.
CLUSTER_RADIUS_METERS=100
# Aviso en tiempo real al dashboard (src/lib/mqtt.ts). Los valores de producción están
# en wrangler.jsonc > vars; aquí solo para sobrescribirlos en local. Sin MQTT_URL no se
# publica nada. El front usa el mismo topic en NUXT_PUBLIC_MQTT_TOPIC.
# MQTT_URL=wss://broker.emqx.io:8084/mqtt
# MQTT_TOPIC=agua-alerta/<slug-aleatorio>/leaks
# Secreto con el que se firman los JWT del panel admin (HS256, mínimo 32 caracteres).
# Los usuarios viven en la tabla `users` (crear con `bun run usuario:crear`).
# Genera uno con: openssl rand -hex 32
JWT_SECRET=

# --- Solo para despliegue por CI/CLI (no van en el Worker) ---
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=
